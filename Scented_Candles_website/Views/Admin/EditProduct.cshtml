@model ScentedCandleWebsite.Models.Product

@{
    ViewData["Title"] = "Edit Candle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as List<ScentedCandleWebsite.Models.Category>;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow border-0" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header py-3" style="background: linear-gradient(135deg, #800000 0%, #5a0000 100%); color: white; border: none;">
                    <h4 class="mb-0">
                        <i class="fas fa-edit me-2"></i> Edit Candle: @Model.Name
                    </h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="EditProduct" asp-controller="Admin" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="ImageUrl" />

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label fw-bold" style="color: #800000;">Candle Name *</label>
                                <input asp-for="Name" class="form-control" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px;" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Scent" class="form-label fw-bold" style="color: #800000;">Scent *</label>
                                <input asp-for="Scent" class="form-control" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px;" />
                                <span asp-validation-for="Scent" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-bold" style="color: #800000;">Description *</label>
                                <textarea asp-for="Description" class="form-control" rows="4" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px; resize: vertical;"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-4">
                                <label asp-for="Price" class="form-label fw-bold" style="color: #800000;">Price (R) *</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background: #800000; color: white; border: 2px solid #800000; border-radius: 10px 0 0 10px;">R</span>
                                    <input asp-for="Price" class="form-control" id="priceInput" style="border-radius: 0 10px 10px 0; border: 2px solid #e8d9cc; padding: 10px 15px;" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="StockQuantity" class="form-label fw-bold" style="color: #800000;">Stock Quantity *</label>
                                <input asp-for="StockQuantity" class="form-control" id="stockInput" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px;" />
                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="CategoryId" class="form-label fw-bold" style="color: #800000;">Category</label>
                                <select asp-for="CategoryId" class="form-control" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px;">
                                    <option value="">Select a category</option>
                                    @if (categories != null)
                                    {
                                        foreach (var category in categories)
                                        {
                                            <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Additional Properties -->
                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label asp-for="Color" class="form-label fw-bold" style="color: #800000;">Color</label>
                                <input asp-for="Color" class="form-control" placeholder="e.g., Purple, White, Blue" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px;" />
                                <span asp-validation-for="Color" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BurnTime" class="form-label fw-bold" style="color: #800000;">Burn Time</label>
                                <input asp-for="BurnTime" class="form-control" placeholder="e.g., 30-40 hours" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px;" />
                                <span asp-validation-for="BurnTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label asp-for="WaxType" class="form-label fw-bold" style="color: #800000;">Wax Type</label>
                                <select asp-for="WaxType" class="form-control" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px;">
                                    <option value="Soy Wax">Soy Wax</option>
                                    <option value="Beeswax">Beeswax</option>
                                    <option value="Paraffin">Paraffin</option>
                                    <option value="Coconut Wax">Coconut Wax</option>
                                    <option value="Palm Wax">Palm Wax</option>
                                </select>
                                <span asp-validation-for="WaxType" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Size" class="form-label fw-bold" style="color: #800000;">Size/Weight</label>
                                <input asp-for="Size" class="form-control" placeholder="e.g., 8oz, 12oz, Large" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px;" />
                                <span asp-validation-for="Size" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <div class="form-check form-switch p-3" style="background: rgba(128, 0, 0, 0.03); border-radius: 10px;">
                                    <input asp-for="IsFeatured" class="form-check-input" type="checkbox" role="switch" style="width: 40px; height: 20px;">
                                    <label asp-for="IsFeatured" class="form-check-label fw-bold" style="color: #800000;">
                                        <i class="fas fa-star me-1"></i> Featured Product
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check form-switch p-3" style="background: rgba(128, 0, 0, 0.03); border-radius: 10px;">
                                    <input asp-for="IsOnSale" class="form-check-input" type="checkbox" role="switch" id="onSaleToggle" style="width: 40px; height: 20px;">
                                    <label asp-for="IsOnSale" class="form-check-label fw-bold" style="color: #800000;">
                                        <i class="fas fa-tag me-1"></i> On Sale
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Sale Price Section -->
                        <div id="salePriceSection" style="display: @(Model.IsOnSale ? "block" : "none");">
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <label asp-for="SalePrice" class="form-label fw-bold" style="color: #800000;">Sale Price</label>
                                    <div class="input-group">
                                        <span class="input-group-text" style="background: #800000; color: white; border: 2px solid #800000; border-radius: 10px 0 0 10px;">R</span>
                                        <input asp-for="SalePrice" class="form-control" style="border-radius: 0 10px 10px 0; border: 2px solid #e8d9cc; padding: 10px 15px;" />
                                    </div>
                                    <span asp-validation-for="SalePrice" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="DiscountPercentage" class="form-label fw-bold" style="color: #800000;">Discount Percentage</label>
                                    <div class="input-group">
                                        <input asp-for="DiscountPercentage" class="form-control" style="border-radius: 10px 0 0 10px; border: 2px solid #e8d9cc; padding: 10px 15px;" />
                                        <span class="input-group-text" style="background: #800000; color: white; border: 2px solid #800000; border-radius: 0 10px 10px 0;">%</span>
                                    </div>
                                    <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <label class="form-label fw-bold" style="color: #800000;">Product Image</label>
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <div class="mb-2">
                                        <img src="@Model.ImageUrl" alt="Current Image" style="max-width: 150px; max-height: 150px; border-radius: 10px; border: 2px solid #e8d9cc; padding: 5px;" />
                                        <p class="text-muted mt-1" style="font-size: 0.85rem;">Current image</p>
                                    </div>
                                }
                                <input type="file" name="productImage" class="form-control" accept="image/*" id="imageUpload" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px;" />
                                <small class="form-text text-muted">Leave empty to keep current image. Upload new image to replace.</small>
                                <div id="imagePreview" class="mt-2" style="display:none;">
                                    <img id="preview" src="#" alt="Preview" style="max-width: 200px; max-height: 200px; border-radius: 10px; border: 2px solid #e8d9cc; padding: 5px;" />
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <div class="form-check form-switch p-3" style="background: rgba(128, 0, 0, 0.03); border-radius: 10px;">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" style="width: 40px; height: 20px;">
                                    <label asp-for="IsActive" class="form-check-label fw-bold" style="color: #800000;">
                                        <i class="fas fa-power-off me-1"></i> Active
                                    </label>
                                    <br />
                                    <small class="form-text text-muted">Inactive products won't be visible to customers.</small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RequiredRole" class="form-label fw-bold" style="color: #800000;">Access Level</label>
                                <select asp-for="RequiredRole" class="form-control" style="border-radius: 10px; border: 2px solid #e8d9cc; padding: 10px 15px;">
                                    <option value="Customer">Everyone (All Customers)</option>
                                    <option value="Admin">Admin Only (Restricted)</option>
                                </select>
                                <small class="form-text text-muted">Restrict this candle to specific user roles.</small>
                            </div>
                        </div>

                        <div class="alert mt-3" style="background: rgba(128, 0, 0, 0.05); border: 1px solid rgba(128, 0, 0, 0.15); border-radius: 12px; color: #4a0000;">
                            <i class="fas fa-info-circle" style="color: #800000;"></i>
                            <strong style="color: #800000;"> Created on:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy")
                        </div>

                        <div class="d-flex flex-wrap gap-2 justify-content-end mt-4 pt-3" style="border-top: 2px solid #f0e4d8;">
                            <a asp-action="Products" class="btn" style="background: white; color: #800000; border: 2px solid #800000; border-radius: 10px; padding: 10px 24px; font-weight: 500;">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn" style="background: #800000; color: white; border: none; border-radius: 10px; padding: 10px 24px; font-weight: 500;">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Handle On Sale toggle
        const onSaleToggle = document.getElementById('onSaleToggle');
        const salePriceSection = document.getElementById('salePriceSection');

        if (onSaleToggle) {
            onSaleToggle.addEventListener('change', function () {
                if (this.checked) {
                    salePriceSection.style.display = 'block';
                } else {
                    salePriceSection.style.display = 'none';
                    document.querySelector('[asp-for="SalePrice"]').value = '';
                    document.querySelector('[asp-for="DiscountPercentage"]').value = '';
                }
            });
        }

        // Price formatting
        const priceInput = document.getElementById('priceInput');
        if (priceInput) {
            priceInput.addEventListener('input', function (e) {
                this.value = this.value.replace(/[^0-9.]/g, '');
                let value = parseFloat(this.value);
                if (!isNaN(value) && value > 0) {
                    this.value = value.toFixed(2);
                }
            });
        }

        // Stock quantity validation
        const stockInput = document.getElementById('stockInput');
        if (stockInput) {
            stockInput.addEventListener('input', function (e) {
                let value = parseInt(this.value);
                if (isNaN(value)) this.value = 0;
                if (value < 0) this.value = 0;
            });
        }

        // Image preview
        const imageUpload = document.getElementById('imageUpload');
        const imagePreview = document.getElementById('imagePreview');
        const preview = document.getElementById('preview');

        if (imageUpload) {
            imageUpload.addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        imagePreview.style.display = 'block';
                    }
                    reader.readAsDataURL(file);
                }
            });
        }
    </script>
}