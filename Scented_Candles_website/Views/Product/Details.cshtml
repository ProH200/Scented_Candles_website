@model Product
@{
    ViewData["Title"] = Model.Name;
    var isAdmin = User.IsInRole("Admin");
    var currentPrice = Model.IsOnSale && Model.SalePrice.HasValue ? Model.SalePrice.Value : Model.Price;
    var originalPrice = Model.Price;
    var savings = Model.IsOnSale && Model.SalePrice.HasValue ? Model.Price - Model.SalePrice.Value : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Name - Candle Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #faf7f2;
            color: #2c1810;
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #b99a85;
            text-decoration: none;
            margin-bottom: 30px;
            transition: color 0.3s;
            font-weight: 500;
        }

            .back-button:hover {
                color: #9c7b66;
            }

        .product-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 5px 30px rgba(0,0,0,0.08);
            margin-bottom: 60px;
        }

        .product-image-section {
            background: #f5eee9;
            padding: 30px;
            position: relative;
        }

        .product-main-image {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 10px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.1);
        }

        .thumbnail-gallery {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            justify-content: center;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 5px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s;
        }

            .thumbnail:hover, .thumbnail.active {
                border-color: #b99a85;
                transform: scale(1.05);
            }

        .badge {
            position: absolute;
            top: 20px;
            left: 20px;
            padding: 8px 20px;
            border-radius: 25px;
            font-size: 14px;
            font-weight: bold;
            z-index: 1;
        }

        .badge-featured {
            background: linear-gradient(135deg, #c4a484, #b99a85);
            color: white;
        }

        .badge-sale {
            background: linear-gradient(135deg, #f44336, #da190b);
            color: white;
            left: auto;
            right: 20px;
        }

        .badge-new {
            background: linear-gradient(135deg, #4CAF50, #45a049);
            color: white;
        }

        .product-info-section {
            padding: 40px 40px 40px 0;
        }

        .product-category {
            display: inline-block;
            background: #f5eee9;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 14px;
            color: #b99a85;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .product-name {
            font-size: 2.5em;
            margin-bottom: 15px;
            color: #2c1810;
            font-weight: 600;
            line-height: 1.2;
        }

        .product-price-section {
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 2px solid #f0e4d8;
        }

        .product-price {
            font-size: 2.2em;
            font-weight: bold;
            color: #b99a85;
        }

        .original-price {
            font-size: 1.2em;
            color: #999;
            text-decoration: line-through;
            margin-left: 10px;
        }

        .savings {
            font-size: 1em;
            color: #4CAF50;
            margin-left: 10px;
        }

        .product-details-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 25px;
            padding: 20px;
            background: #faf7f2;
            border-radius: 10px;
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .detail-item i {
                width: 30px;
                color: #b99a85;
                font-size: 18px;
            }

            .detail-item strong {
                font-weight: 600;
                margin-right: 8px;
            }

            .detail-item span {
                color: #7d6b5e;
            }

        .stock-status {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 25px;
        }

            .stock-status.in-stock {
                background: #e8f5e9;
                color: #2e7d32;
            }

            .stock-status.low-stock {
                background: #fff3e0;
                color: #e65100;
            }

            .stock-status.out-stock {
                background: #ffebee;
                color: #c62828;
            }

            .stock-status i {
                font-size: 20px;
            }

        .quantity-section {
            margin-bottom: 25px;
        }

        .quantity-label {
            display: block;
            margin-bottom: 10px;
            font-weight: 600;
            color: #2c1810;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .quantity-btn {
            width: 40px;
            height: 40px;
            background: #f5eee9;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 18px;
            font-weight: bold;
            transition: background 0.3s;
        }

            .quantity-btn:hover {
                background: #e8d9cc;
            }

        .quantity-input {
            width: 80px;
            height: 40px;
            text-align: center;
            font-size: 16px;
            border: 2px solid #e8d9cc;
            border-radius: 5px;
            outline: none;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }

        .btn-add-cart {
            flex: 2;
            padding: 15px;
            background: #b99a85;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-add-cart:hover:not(:disabled) {
                background: #9c7b66;
                transform: translateY(-2px);
            }

            .btn-add-cart:disabled {
                background: #ccc;
                cursor: not-allowed;
            }

        .btn-wishlist {
            flex: 1;
            padding: 15px;
            background: white;
            color: #b99a85;
            border: 2px solid #b99a85;
            border-radius: 10px;
            font-size: 18px;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-wishlist:hover {
                background: #b99a85;
                color: white;
            }

        .product-tabs {
            margin-top: 40px;
        }

        .tab-buttons {
            display: flex;
            gap: 10px;
            border-bottom: 2px solid #f0e4d8;
            margin-bottom: 25px;
        }

        .tab-btn {
            padding: 12px 25px;
            background: none;
            border: none;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            color: #7d6b5e;
            transition: all 0.3s;
            position: relative;
        }

            .tab-btn.active {
                color: #b99a85;
            }

                .tab-btn.active::after {
                    content: '';
                    position: absolute;
                    bottom: -2px;
                    left: 0;
                    right: 0;
                    height: 2px;
                    background: #b99a85;
                }

        .tab-content {
            display: none;
            padding: 20px;
            background: white;
            border-radius: 10px;
        }

            .tab-content.active {
                display: block;
            }

            .tab-content p {
                line-height: 1.8;
                color: #2c1810;
            }

        .admin-actions {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 2px solid #f0e4d8;
            display: flex;
            gap: 15px;
        }

        .btn-admin {
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            font-size: 14px;
            transition: all 0.3s;
        }

        .btn-edit {
            background: #2196F3;
            color: white;
        }

            .btn-edit:hover {
                background: #0b7dda;
            }

        .btn-delete {
            background: #f44336;
            color: white;
        }

            .btn-delete:hover {
                background: #da190b;
            }

        .reviews-section {
            margin-top: 60px;
            padding: 30px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 5px 30px rgba(0,0,0,0.08);
        }

        .reviews-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #f0e4d8;
        }

            .reviews-header h3 {
                font-size: 1.5em;
                color: #2c1810;
            }

        .btn-review {
            padding: 10px 20px;
            background: #b99a85;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        @@media (max-width: 768px) {
            .product-container {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .product-info-section {
                padding: 30px;
            }

            .product-details-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
            }

            .product-name {
                font-size: 1.8em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <a asp-action="Index" asp-controller="Products" class="back-button">
            <i class="fas fa-arrow-left"></i> Back to Shop
        </a>

        <div class="product-container">
            <div class="product-image-section">
                <!-- Badges -->
                @if (Model.IsFeatured)
                {
                    <div class="badge badge-featured">
                        <i class="fas fa-star"></i> Featured
                    </div>
                }
                @if (Model.IsOnSale)
                {
                    <div class="badge badge-sale">
                        <i class="fas fa-tag"></i> @(Model.DiscountPercentage ?? 0)% OFF
                    </div>
                }
                @if (Model.CreatedAt > DateTime.Now.AddDays(-30))
                {
                    <div class="badge badge-new" style="left: auto; right: 20px; top: 80px;">
                        <i class="fas fa-newspaper"></i> New
                    </div>
                }

                <!-- Main Image -->
                <img id="mainImage" src="@Model.ImageUrl" alt="@Model.Name" class="product-main-image"
                     onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1603006905003-be475563bc59?w=600&h=400&fit=crop'">

                <!-- Thumbnail Gallery -->
                <div class="thumbnail-gallery">
                    <img src="@Model.ImageUrl" alt="Main" class="thumbnail active" onclick="changeImage(this.src)">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl2))
                    {
                        <img src="@Model.ImageUrl2" alt="Image 2" class="thumbnail" onclick="changeImage(this.src)">
                    }
                    @if (!string.IsNullOrEmpty(Model.ImageUrl3))
                    {
                        <img src="@Model.ImageUrl3" alt="Image 3" class="thumbnail" onclick="changeImage(this.src)">
                    }
                    @if (!string.IsNullOrEmpty(Model.ImageUrl4))
                    {
                        <img src="@Model.ImageUrl4" alt="Image 4" class="thumbnail" onclick="changeImage(this.src)">
                    }
                </div>
            </div>

            <div class="product-info-section">
                <div class="product-category">
                    @Model.Category?.Name ?? "Uncategorized"
                </div>

                <h1 class="product-name">@Model.Name</h1>

                <div class="product-price-section">
                    @if (Model.IsOnSale && Model.SalePrice.HasValue)
                    {
                        <span class="product-price">$@Model.SalePrice.Value.ToString("F2")</span>
                        <span class="original-price">$@Model.Price.ToString("F2")</span>
                        <span class="savings">Save $@savings.ToString("F2") (@(Model.DiscountPercentage ?? 0)% off)</span>
                    }
                    else
                    {
                        <span class="product-price">$@Model.Price.ToString("F2")</span>
                    }
                </div>

                <!-- Product Details Grid -->
                <div class="product-details-grid">
                    @if (!string.IsNullOrEmpty(Model.Scent))
                    {
                        <div class="detail-item">
                            <i class="fas fa-leaf"></i>
                            <strong>Scent:</strong>
                            <span>@Model.Scent</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Color))
                    {
                        <div class="detail-item">
                            <i class="fas fa-palette"></i>
                            <strong>Color:</strong>
                            <span>@Model.Color</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.BurnTime))
                    {
                        <div class="detail-item">
                            <i class="far fa-clock"></i>
                            <strong>Burn Time:</strong>
                            <span>@Model.BurnTime</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.WaxType))
                    {
                        <div class="detail-item">
                            <i class="fas fa-tint"></i>
                            <strong>Wax Type:</strong>
                            <span>@Model.WaxType</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Size))
                    {
                        <div class="detail-item">
                            <i class="fas fa-weight-hanging"></i>
                            <strong>Size:</strong>
                            <span>@Model.Size</span>
                        </div>
                    }
                </div>

                <!-- Stock Status - Using simple conditions directly -->
                @{
                    var productInStock = Model.IsActive && Model.StockQuantity > 0;
                    var productLowStock = productInStock && Model.StockQuantity < 10;
                }

                @if (productInStock)
                {
                    <div class="stock-status @(productLowStock ? "low-stock" : "in-stock")">
                        <i class="fas @(productLowStock ? "fa-exclamation-triangle" : "fa-check-circle")"></i>
                        <span>
                            @if (productLowStock)
                            {
                                <strong>Low Stock!</strong>
                                <text>Only @Model.StockQuantity items left</text>
                            }
                            else
                            {
                                <strong>In Stock</strong>
                                <text>Ready to ship</text>
                            }
                        </span>
                    </div>
                }
                else
                {
                    <div class="stock-status out-stock">
                        <i class="fas fa-times-circle"></i>
                        <span><strong>Out of Stock</strong> This item is currently unavailable</span>
                    </div>
                }

                @if (productInStock)
                {
                    <div class="quantity-section">
                        <label class="quantity-label">Quantity:</label>
                        <div class="quantity-selector">
                            <button type="button" class="quantity-btn" onclick="changeQuantity(-1)">-</button>
                            <input type="number" id="quantity" class="quantity-input" value="1" min="1" max="@Model.StockQuantity">
                            <button type="button" class="quantity-btn" onclick="changeQuantity(1)">+</button>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <button class="btn-add-cart" onclick="addToCart(@Model.Id)">
                            <i class="fas fa-shopping-cart"></i> Add to Cart
                        </button>
                        <button class="btn-wishlist" onclick="addToWishlist(@Model.Id)">
                            <i class="far fa-heart"></i> Wishlist
                        </button>
                    </div>
                }

                <!-- Social Share -->
                <div style="margin-top: 20px;">
                    <small style="color: #7d6b5e;">Share this product:</small>
                    <div style="margin-top: 10px; display: flex; gap: 10px;">
                        <a href="#" onclick="shareProduct('facebook')" style="color: #1877f2;">
                            <i class="fab fa-facebook fa-lg"></i>
                        </a>
                        <a href="#" onclick="shareProduct('twitter')" style="color: #1da1f2;">
                            <i class="fab fa-twitter fa-lg"></i>
                        </a>
                        <a href="#" onclick="shareProduct('pinterest')" style="color: #bd081c;">
                            <i class="fab fa-pinterest fa-lg"></i>
                        </a>
                        <a href="#" onclick="shareProduct('email')" style="color: #b99a85;">
                            <i class="fas fa-envelope fa-lg"></i>
                        </a>
                    </div>
                </div>

                @if (isAdmin)
                {
                    <div class="admin-actions">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-admin btn-edit">
                            <i class="fas fa-edit"></i> Edit Product
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-admin btn-delete" onclick="return confirm('Are you sure you want to delete this product?')">
                            <i class="fas fa-trash"></i> Delete Product
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="product-tabs">
            <div class="tab-buttons">
                <button class="tab-btn active" onclick="switchTab('description')">Description</button>
                <button class="tab-btn" onclick="switchTab('details')">Product Details</button>
                <button class="tab-btn" onclick="switchTab('shipping')">Shipping Info</button>
            </div>

            <div id="description" class="tab-content active">
                <p>@Model.Description</p>
            </div>

            <div id="details" class="tab-content">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr style="border-bottom: 1px solid #f0e4d8;">
                        <td style="padding: 12px 0;"><strong>Product Name:</strong></td>
                        <td style="padding: 12px 0;">@Model.Name</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f0e4d8;">
                        <td style="padding: 12px 0;"><strong>Category:</strong></td>
                        <td style="padding: 12px 0;">@Model.Category?.Name</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f0e4d8;">
                        <td style="padding: 12px 0;"><strong>Scent:</strong></td>
                        <td style="padding: 12px 0;">@Model.Scent</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f0e4d8;">
                        <td style="padding: 12px 0;"><strong>Color:</strong></td>
                        <td style="padding: 12px 0;">@Model.Color</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f0e4d8;">
                        <td style="padding: 12px 0;"><strong>Wax Type:</strong></td>
                        <td style="padding: 12px 0;">@Model.WaxType</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f0e4d8;">
                        <td style="padding: 12px 0;"><strong>Burn Time:</strong></td>
                        <td style="padding: 12px 0;">@Model.BurnTime</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.Size))
                    {
                        <tr style="border-bottom: 1px solid #f0e4d8;">
                            <td style="padding: 12px 0;"><strong>Size:</strong></td>
                            <td style="padding: 12px 0;">@Model.Size</td>
                        </tr>
                    }
                    <tr style="border-bottom: 1px solid #f0e4d8;">
                        <td style="padding: 12px 0;"><strong>Stock:</strong></td>
                        <td style="padding: 12px 0;">@Model.StockQuantity units</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f0e4d8;">
                        <td style="padding: 12px 0;"><strong>Added Date:</strong></td>
                        <td style="padding: 12px 0;">@Model.CreatedAt.ToString("MMMM dd, yyyy")</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f0e4d8;">
                        <td style="padding: 12px 0;"><strong>SKU:</strong></td>
                        <td style="padding: 12px 0;">CND-@Model.Id.ToString("D4")</td>
                    </tr>
                </table>
            </div>

            <div id="shipping" class="tab-content">
                <h4 style="margin-bottom: 15px;">Shipping Information</h4>
                <p><strong>Free Shipping:</strong> On orders over $50</p>
                <p><strong>Processing Time:</strong> 1-2 business days</p>
                <p><strong>Delivery Time:</strong> 3-5 business days</p>
                <p><strong>Returns:</strong> 30-day return policy</p>
            </div>
        </div>

        <div class="reviews-section">
            <div class="reviews-header">
                <h3><i class="fas fa-star"></i> Customer Reviews</h3>
                <button class="btn-review" onclick="writeReview()">Write a Review</button>
            </div>
            <div id="reviews-container">
                <p style="text-align: center; color: #7d6b5e;">Be the first to review this product!</p>
            </div>
        </div>
    </div>

    <script>
        function changeImage(src) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.thumbnail').forEach(thumb => {
                thumb.classList.remove('active');
            });
            event.target.classList.add('active');
        }

        function changeQuantity(delta) {
            const input = document.getElementById('quantity');
            if (!input) return;
            let newValue = parseInt(input.value) + delta;
            const max = parseInt(input.max);
            if (newValue < 1) newValue = 1;
            if (newValue > max) newValue = max;
            input.value = newValue;
        }

        function addToCart(productId) {
            const quantity = document.getElementById('quantity')?.value || 1;
            fetch('/Cart/Add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: productId, quantity: parseInt(quantity) })
            })
                .then(response => {
                    if (response.ok) {
                        showNotification('Added to cart!', 'success');
                    } else {
                        showNotification('Error adding to cart', 'error');
                    }
                })
                .catch(() => showNotification('Error adding to cart', 'error'));
        }

        function addToWishlist(productId) {
            fetch('/Wishlist/Add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: productId })
            })
                .then(response => {
                    if (response.ok) {
                        showNotification('Added to wishlist!', 'success');
                    } else {
                        showNotification('Please login to add to wishlist', 'info');
                    }
                })
                .catch(() => showNotification('Error', 'error'));
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            event.target.classList.add('active');
        }

        function shareProduct(platform) {
            const url = encodeURIComponent(window.location.href);
            const title = encodeURIComponent('@Model.Name');
            const shareUrls = {
                facebook: `https://www.facebook.com/sharer/sharer.php?u=${url}`,
                twitter: `https://twitter.com/intent/tweet?text=${title}&url=${url}`,
                pinterest: `https://pinterest.com/pin/create/button/?url=${url}&description=${title}`,
                email: `mailto:?subject=${title}&body=Check out: ${url}`
            };
            if (shareUrls[platform]) {
                window.open(shareUrls[platform], '_blank', 'width=600,height=400');
            }
        }

        function writeReview() {
            window.location.href = `/Product/WriteReview/@Model.Id`;
        }

        function showNotification(message, type) {
            const notification = document.createElement('div');
            const colors = { success: '#4CAF50', error: '#f44336', info: '#2196F3' };
            notification.style.cssText = `
                        position: fixed;
                        top: 20px;
                        right: 20px;
                        padding: 15px 20px;
                        background: ${colors[type]};
                        color: white;
                        border-radius: 5px;
                        z-index: 1000;
                        animation: slideIn 0.3s ease;
                    `;
            notification.innerHTML = message;
            document.body.appendChild(notification);
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        // Add animation styles
        const style = document.createElement('style');
        style.textContent = `
                    @@keyframes slideIn {
                        from {
                            transform: translateX(100%);
                            opacity: 0;
                        }
                        to {
                            transform: translateX(0);
                            opacity: 1;
                        }
                    }
                `;
        document.head.appendChild(style);
    </script>
</body>
</html>