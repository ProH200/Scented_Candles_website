@model IEnumerable<Order>

@{
    ViewData["Title"] = "Order History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2" style="color: #800000;">
            <i class="fas fa-history me-2"></i>Order History
        </h1>
        <a asp-controller="Home" asp-action="Index" class="btn" style="background: #800000; color: white; border-radius: 10px; padding: 8px 20px;">
            <i class="fas fa-arrow-left me-1"></i> Continue Shopping
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-bag" style="font-size: 60px; color: #e8d9cc;"></i>
            <h3 class="mt-3" style="color: #2c1810;">No Orders Yet</h3>
            <p class="text-muted">You haven't placed any orders yet. Start shopping to fill your home with beautiful scents!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-lg mt-2" style="background: #800000; color: white; border-radius: 12px; padding: 12px 40px;">
                <i class="fas fa-candle me-2"></i> Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm border-0" style="border-radius: 16px; overflow: hidden;">
                        <div class="card-header d-flex flex-wrap justify-content-between align-items-center" style="background: #f8f9fa; border-bottom: 1px solid #f0e4d8; padding: 15px 20px;">
                            <div>
                                <span class="fw-bold" style="color: #800000;">Order #@order.Id</span>
                                <span class="text-muted ms-3">@order.OrderDate.ToString("MMM dd, yyyy hh:mm tt")</span>
                            </div>
                            <div>
                                <span class="badge" style="background: @(order.Status == "Pending" ? "#ffc107" : order.Status == "Processing" ? "#17a2b8" : order.Status == "Shipped" ? "#6f42c1" : order.Status == "Delivered" ? "#28a745" : "#dc3545"); color: @(order.Status == "Pending" ? "#2c1810" : "white"); padding: 6px 16px; font-size: 0.8rem; border-radius: 20px;">
                                    @(order.Status == "Pending" ? "📋" : order.Status == "Processing" ? "⚙️" : order.Status == "Shipped" ? "🚚" : order.Status == "Delivered" ? "✅" : "❌") @order.Status
                                </span>
                                <span class="fw-bold ms-3" style="color: #800000; font-size: 1.1rem;">R @order.TotalAmount.ToString("F2")</span>
                            </div>
                        </div>
                        <div class="card-body p-20">
                            <div class="row">
                                <div class="col-md-8">
                                    @foreach (var item in order.OrderItems.Take(3))
                                    {
                                        <div class="d-flex align-items-center mb-2">
                                            <img src="@(item.Product?.ImageUrl ?? "/images/default-candle.jpg")" alt="@item.Product?.Name"
                                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px; margin-right: 12px;"
                                                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1603006905003-be475563bc59?w=100&h=100&fit=crop'">
                                            <div>
                                                <div style="font-weight: 500; color: #2c1810;">@item.Product?.Name</div>
                                                <div class="text-muted" style="font-size: 0.85rem;">Qty: @item.Quantity × R @item.Price.ToString("F2")</div>
                                            </div>
                                            <span class="ms-auto fw-bold" style="color: #800000;">R @((item.Quantity * item.Price).ToString("F2"))</span>
                                        </div>
                                    }
                                    @if (order.OrderItems.Count > 3)
                                    {
                                        <div class="text-muted text-center" style="font-size: 0.85rem;">
                                            + @(order.OrderItems.Count - 3) more items
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <div class="mb-2">
                                        <span class="text-muted" style="font-size: 0.85rem;">Delivery:</span>
                                        @if (order.OrderDate.AddDays(7) > DateTime.Now && order.Status != "Delivered" && order.Status != "Cancelled")
                                        {
                                            <span class="text-warning">Expected @order.OrderDate.AddDays(7).ToString("MMM dd, yyyy")</span>
                                        }
                                        else if (order.Status == "Delivered")
                                        {
                                            <span class="text-success">Delivered</span>
                                        }
                                        else if (order.Status == "Cancelled")
                                        {
                                            <span class="text-danger">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Processing</span>
                                        }
                                    </div>
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm" style="background: #800000; color: white; border: none; border-radius: 8px; padding: 6px 18px;">
                                        <i class="fas fa-eye me-1"></i> View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>