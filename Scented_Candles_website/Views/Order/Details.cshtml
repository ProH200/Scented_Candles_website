@model Order

@{
    ViewData["Title"] = "Order Details #" + Model.Id;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2" style="color: #800000;">
            <i class="fas fa-receipt me-2"></i>Order #@Model.Id
        </h1>
        <a asp-action="History" class="btn" style="background: #800000; color: white; border-radius: 10px; padding: 8px 20px;">
            <i class="fas fa-arrow-left me-1"></i> Back to History
        </a>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 16px; overflow: hidden;">
        <div class="card-header" style="background: linear-gradient(135deg, #800000 0%, #5a0000 100%); color: white; border: none; padding: 20px 25px;">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-0">
                        <i class="fas fa-shopping-cart me-2"></i> Order Details
                    </h5>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="badge" style="background: rgba(255,255,255,0.2); padding: 6px 20px; font-size: 0.85rem; border-radius: 20px;">
                        @Model.Status
                    </span>
                    <span class="ms-2" style="font-size: 1.1rem;">R @Model.TotalAmount.ToString("F2")</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- Customer & Shipping Info -->
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="p-3" style="background: #f8f9fa; border-radius: 12px; height: 100%;">
                        <h6 style="color: #800000; font-weight: 700; margin-bottom: 12px;">
                            <i class="fas fa-user me-2"></i>Customer Information
                        </h6>
                        <p class="mb-1"><strong>Name:</strong> @Model.User?.FirstName @Model.User?.LastName</p>
                        <p class="mb-1"><strong>Email:</strong> @Model.User?.Email</p>
                        <p class="mb-0"><strong>Phone:</strong> @Model.PhoneNumber</p>
                        <p class="mb-0 mt-2"><strong>Order Date:</strong> @Model.OrderDate.ToString("MMMM dd, yyyy hh:mm tt")</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3" style="background: #f8f9fa; border-radius: 12px; height: 100%;">
                        <h6 style="color: #800000; font-weight: 700; margin-bottom: 12px;">
                            <i class="fas fa-truck me-2"></i>Shipping Address
                        </h6>
                        <p class="mb-1">@Model.ShippingAddress</p>
                        <p class="mb-1">@Model.City, @Model.PostalCode</p>
                        <p class="mb-0">@Model.Country</p>
                    </div>
                </div>
            </div>

            <!-- Order Items -->
            <h6 style="color: #800000; font-weight: 700; margin-bottom: 15px;">
                <i class="fas fa-box me-2"></i>Order Items
            </h6>
            <div class="table-responsive">
                <table class="table table-hover" style="border-radius: 12px; overflow: hidden;">
                    <thead style="background: #800000; color: white;">
                        <tr>
                            <th style="padding: 12px 15px;">Product</th>
                            <th style="padding: 12px 15px;">Quantity</th>
                            <th style="padding: 12px 15px;">Price</th>
                            <th style="padding: 12px 15px;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td style="padding: 12px 15px;">
                                    <div class="d-flex align-items-center">
                                        <img src="@(item.Product?.ImageUrl ?? "/images/default-candle.jpg")" alt="@item.Product?.Name"
                                             style="width: 40px; height: 40px; object-fit: cover; border-radius: 6px; margin-right: 12px;"
                                             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1603006905003-be475563bc59?w=50&h=50&fit=crop'">
                                        <span style="font-weight: 500;">@item.Product?.Name</span>
                                    </div>
                                </td>
                                <td style="padding: 12px 15px;">@item.Quantity</td>
                                <td style="padding: 12px 15px;">R @item.Price.ToString("F2")</td>
                                <td style="padding: 12px 15px; font-weight: 600; color: #800000;">R @((item.Quantity * item.Price).ToString("F2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot style="background: #f8f9fa; font-weight: 700;">
                        <tr>
                            <td colspan="3" class="text-end" style="padding: 12px 15px;">Total:</td>
                            <td style="padding: 12px 15px; color: #800000; font-size: 1.1rem;">R @Model.TotalAmount.ToString("F2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Order Status Timeline -->
            <div class="mt-4 p-3" style="background: #f8f9fa; border-radius: 12px;">
                <h6 style="color: #800000; font-weight: 700; margin-bottom: 12px;">
                    <i class="fas fa-clock me-2"></i>Order Status
                </h6>
                <div class="d-flex flex-wrap gap-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-2" style="background: #28a745; width: 10px; height: 10px;"></div>
                        <span class="ms-2" style="font-size: 0.9rem;">Order Placed</span>
                    </div>
                    @if (Model.Status == "Processing" || Model.Status == "Shipped" || Model.Status == "Delivered")
                    {
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-2" style="background: #28a745; width: 10px; height: 10px;"></div>
                            <span class="ms-2" style="font-size: 0.9rem;">Processing</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-2" style="background: #e8d9cc; width: 10px; height: 10px;"></div>
                            <span class="ms-2 text-muted" style="font-size: 0.9rem;">Processing</span>
                        </div>
                    }
                    @if (Model.Status == "Shipped" || Model.Status == "Delivered")
                    {
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-2" style="background: #28a745; width: 10px; height: 10px;"></div>
                            <span class="ms-2" style="font-size: 0.9rem;">Shipped</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-2" style="background: #e8d9cc; width: 10px; height: 10px;"></div>
                            <span class="ms-2 text-muted" style="font-size: 0.9rem;">Shipped</span>
                        </div>
                    }
                    @if (Model.Status == "Delivered")
                    {
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-2" style="background: #28a745; width: 10px; height: 10px;"></div>
                            <span class="ms-2" style="font-size: 0.9rem;">Delivered</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-2" style="background: #e8d9cc; width: 10px; height: 10px;"></div>
                            <span class="ms-2 text-muted" style="font-size: 0.9rem;">Delivered</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>