<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Scented Candle Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark shadow-sm" style="background: linear-gradient(135deg, #800000 0%, #5a0000 100%);">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-candle me-2"></i> Glow & Grace
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Product" asp-action="Index">
                                <i class="fas fa-candle me-1"></i> Shop
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Product" asp-action="About">
                                <i class="fas fa-candle me-1"></i> About
                            </a>
                        </li>

                        @* Admin-only menu items *@
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-cog me-1"></i> Admin Panel
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminDropdown" style="background: #2d2d2d; border: none; border-radius: 12px;">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                            <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Products">
                                            <i class="fas fa-candle me-2"></i> Manage Products
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="CreateProduct">
                                            <i class="fas fa-plus-circle me-2"></i> Add New Candle
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Orders">
                                            <i class="fas fa-shopping-cart me-2"></i> Manage Orders
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                            <i class="fas fa-users me-2"></i> Manage Users
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @* Customer-only menu items *@
                        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Order" asp-action="History">
                                    <i class="fas fa-shopping-bag me-1"></i> My Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white position-relative" asp-controller="Cart" asp-action="Index">
                                    <i class="fas fa-shopping-cart me-1"></i> Cart
                                    <span id="cartCountBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning" style="font-size: 10px; display: none; color: #800000;">
                                        0
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-1"></i>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-warning text-dark me-1">Admin</span>
                                    }
                                    <span>@User.Identity?.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" aria-labelledby="userDropdown" style="background: #2d2d2d; border: none; border-radius: 12px;">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="fas fa-user-circle me-2"></i> My Profile
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="LogoutPost" method="post" id="logoutForm">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">
                                                <i class="fas fa-sign-out-alt me-2"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus me-1"></i> Register
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt me-1"></i> Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 rounded-3 shadow-sm" role="alert" style="background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%); color: #155724; border-left: 4px solid #28a745;">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 shadow-sm" role="alert" style="background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%); color: #721c24; border-left: 4px solid #dc3545;">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <!-- ===== FOOTER ===== -->
    <footer class="footer" style="background: #2c1810; color: white; padding: 60px 0 30px;">
        <div class="container">
            <div class="row g-4">
                <!-- Brand Section -->
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3" style="font-family: 'Playfair Display', serif; font-size: 1.5rem;">
                        <i class="fas fa-candle me-2" style="color: #b99a85;"></i>Scented<span style="color: #b99a85;">Candles</span>
                    </h5>
                    <p class="text-white-50 small" style="line-height: 1.8; max-width: 350px;">
                        Handcrafted with love, scented with nature, and made to create unforgettable moments.
                    </p>
                </div>

                @* <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3" style="color: #b99a85; font-size: 1rem; text-transform: uppercase; letter-spacing: 1px;">Quick Links</h6>
                    <ul class="list-unstyled" style="font-size: 0.9rem;">
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none" style="transition: all 0.3s;">Shop All</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none" style="transition: all 0.3s;">New Arrivals</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none" style="transition: all 0.3s;">Best Sellers</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none" style="transition: all 0.3s;">On Sale</a></li>
                    </ul>
                </div> *@

                @* <!-- Customer Service -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3" style="color: #b99a85; font-size: 1rem; text-transform: uppercase; letter-spacing: 1px;">Customer Service</h6>
                    <ul class="list-unstyled" style="font-size: 0.9rem;">
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none" style="transition: all 0.3s;">Shipping Info</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none" style="transition: all 0.3s;">Returns Policy</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none" style="transition: all 0.3s;">FAQs</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none" style="transition: all 0.3s;">Track Order</a></li>
                    </ul>
                </div> *@

                <!-- Contact Info -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3" style="color: #b99a85; font-size: 1rem; text-transform: uppercase; letter-spacing: 1px;">Contact Us</h6>
                    <ul class="list-unstyled" style="font-size: 0.9rem;">
                        <li class="mb-2 text-white-50">
                            <i class="fas fa-envelope me-2" style="color: #b99a85; width: 20px;"></i>
                            <a href="mailto:hello@scentedcandles.com" class="text-white-50 text-decoration-none" style="transition: all 0.3s;">Promisemnelisi@gmail.com</a>
                        </li>
                        <li class="mb-2 text-white-50">
                            <i class="fas fa-phone me-2" style="color: #b99a85; width: 20px;"></i>
                            <a href="tel:+27661390332" class="text-white-50 text-decoration-none" style="transition: all 0.3s;">066 139-0332</a>
                        </li>
                        <li class="mb-2 text-white-50">
                            <i class="fas fa-map-marker-alt me-2" style="color: #b99a85; width: 20px;"></i>
                            <span>45 western road(Park Place) , Port Elizabeth , Eastern cape</span>
                        </li>
                        <li class="mb-2 text-white-50">
                            <i class="fas fa-clock me-2" style="color: #b99a85; width: 20px;"></i>
                            <span>Mon-Fri: 08:00 AM - 4:00 PM</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Footer Bottom -->
            <div class="row mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,0.08);">
                <div class="col-md-6 text-center text-md-start">
                    <p class="text-white-50 small mb-0">
                        &copy; @DateTime.Now.Year Scented Candles. All rights reserved.
                    </p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p class="text-white-50 small mb-0">
                        <i class="fas fa-heart" style="color: #b99a85;"></i> Crafted with love
                        <span class="mx-2">|</span>
                        <i class="fas fa-leaf" style="color: #b99a85;"></i> Eco-friendly
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <style>
        /* Social Links Hover Effect */
        .social-links a {
            transition: all 0.3s ease;
        }

            .social-links a:hover {
                background: #b99a85 !important;
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(185, 154, 133, 0.3);
            }

        /* Quick Links & Customer Service Hover */
        .list-unstyled a:hover {
            color: #b99a85 !important;
            padding-left: 5px;
        }

        /* Contact Info Hover */
        .list-unstyled a[href^="mailto"]:hover,
        .list-unstyled a[href^="tel"]:hover {
            color: #b99a85 !important;
        }

        /* Responsive Adjustments */
        @@media (max-width: 768px) {
            .footer {
                padding: 40px 0 20px;
            }

            .social-links a {
                width: 32px !important;
                height: 32px !important;
                line-height: 32px !important;
                font-size: 12px !important;
            }
        }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Function to update cart count badge
        function updateCartCount() {
            if (@(User.Identity?.IsAuthenticated == true ? "true" : "false")) {
                $.ajax({
                    url: '@Url.Action("GetCartCount", "Cart")',
                    type: 'GET',
                    success: function (data) {
                        if (data.count > 0) {
                            $('#cartCountBadge').text(data.count).show();
                        } else {
                            $('#cartCountBadge').hide();
                        }
                    },
                    error: function () {
                        console.log('Error fetching cart count');
                    }
                });
            }
        }

        // Update cart count on page load
        $(document).ready(function () {
            updateCartCount();
        });

        // Auto-hide alerts after 5 seconds
        setTimeout(function () {
            $('.alert').fadeOut('slow');
        }, 5000);

        // Add active class to current nav item
        $(document).ready(function () {
            var currentUrl = window.location.pathname;
            $('.navbar-nav .nav-link').each(function () {
                if ($(this).attr('href') === currentUrl) {
                    $(this).addClass('active');
                    $(this).css('font-weight', 'bold');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>