@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <!-- Header with Maroon Gradient -->
                <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #800000 0%, #5a0000 100%); border: none;">
                    <div class="mb-3">
                        <i class="fas fa-candle fa-4x" style="filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.3));"></i>
                    </div>
                    <h3 class="mb-0 fw-bold">Welcome Back!</h3>
                    <p class="mb-0 mt-2 small" style="opacity: 0.9;">Sign in to continue your aromatic journey</p>
                </div>

                <div class="card-body p-4" style="background: white;">
                    <!-- Success Message -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 rounded-3 mb-4" role="alert" style="background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%); color: #155724; border-left: 4px solid #28a745;">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Error Message -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 mb-4" role="alert" style="background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%); color: #721c24; border-left: 4px solid #dc3545;">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <!-- Email Field -->
                        <div class="form-group mb-4">
                            <label asp-for="Email" class="form-label fw-semibold" style="color: #4a0000;">
                                <i class="fas fa-envelope me-2"></i>Email Address
                            </label>
                            <div class="input-group">
                                <span class="input-group-text border-0 bg-light" style="border-radius: 12px 0 0 12px;">
                                    <i class="fas fa-envelope" style="color: #800000;"></i>
                                </span>
                                <input asp-for="Email" class="form-control" placeholder="Enter your email" style="border-radius: 0 12px 12px 0; border-left: none;" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Password Field -->
                        <div class="form-group mb-4">
                            <label asp-for="Password" class="form-label fw-semibold" style="color: #4a0000;">
                                <i class="fas fa-lock me-2"></i>Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text border-0 bg-light" style="border-radius: 12px 0 0 12px;">
                                    <i class="fas fa-key" style="color: #800000;"></i>
                                </span>
                                <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" style="border-radius: 0 12px 12px 0; border-left: none;" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Remember Me & Forgot Password Row -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" id="rememberMe" style="border-color: #800000; cursor: pointer;">
                                <label class="form-check-label" for="rememberMe" style="color: #4a0000;">
                                    <i class="fas fa-clock me-1"></i>Remember me
                                </label>
                            </div>
                            <a asp-action="ForgotPassword" class="text-decoration-none small" style="color: #800000;">
                                <i class="fas fa-question-circle me-1"></i>Forgot Password?
                            </a>
                        </div>

                        <!-- Login Button -->
                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn btn-lg fw-bold text-white" style="background: linear-gradient(135deg, #800000 0%, #5a0000 100%); border: none; border-radius: 50px; padding: 12px; transition: all 0.3s ease;">
                                <i class="fas fa-sign-in-alt me-2"></i> Login
                            </button>
                        </div>

                        <!-- Divider -->
                        <div class="position-relative text-center my-4">
                            <hr class="border-secondary" style="opacity: 0.3;">
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3" style="color: #6c757d; font-size: 14px;">OR</span>
                        </div>

                        
                    </form>
                </div>

                <!-- Footer with Register Link -->
                <div class="card-footer text-center py-3" style="background: #f8f9fa; border-top: 1px solid rgba(0,0,0,0.05);">
                    <p class="mb-0" style="color: #4a0000;">
                        Don't have an account?
                        <a asp-action="Register" class="fw-bold text-decoration-none" style="color: #800000;">
                            <i class="fas fa-user-plus me-1"></i>Register here
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom CSS for Hover Effects -->
<style>
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(128, 0, 0, 0.3);
    }

    .form-control:focus {
        border-color: #800000;
        box-shadow: 0 0 0 0.2rem rgba(128, 0, 0, 0.25);
    }

    .input-group-text {
        background: #f8f9fa;
        border-right: none;
    }

    .input-group .form-control:focus {
        border-left: none;
        box-shadow: none;
    }

    .card {
        animation: fadeInUp 0.5s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-check-input:checked {
        background-color: #800000;
        border-color: #800000;
    }

    .alert {
        animation: slideDown 0.3s ease-out;
    }

    @@keyframes slideDown {
        from {
            transform: translateY(-100%);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Auto-hide alerts after 5 seconds
        setTimeout(function () {
            $('.alert').fadeOut('slow');
        }, 5000);

        // Add floating label effect (optional)
        const inputs = document.querySelectorAll('.form-control');
        inputs.forEach(input => {
            input.addEventListener('focus', function () {
                this.parentElement.classList.add('focused');
            });
            input.addEventListener('blur', function () {
                if (!this.value) {
                    this.parentElement.classList.remove('focused');
                }
            });
        });
    </script>
}