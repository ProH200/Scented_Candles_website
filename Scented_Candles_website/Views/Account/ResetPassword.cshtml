@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Scented Candles</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #faf7f2 0%, #e8d9cc 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .reset-container {
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
            padding: 50px 40px;
            max-width: 480px;
            width: 100%;
            animation: fadeInUp 0.5s ease-out;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .reset-header {
            text-align: center;
            margin-bottom: 35px;
        }

            .reset-header .icon {
                width: 70px;
                height: 70px;
                background: rgba(128, 0, 0, 0.08);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 15px;
                font-size: 30px;
                color: #800000;
            }

            .reset-header h1 {
                font-size: 1.8em;
                color: #2c1810;
                font-weight: 700;
            }

            .reset-header p {
                color: #7d6b5e;
                font-size: 0.95em;
                margin-top: 8px;
                line-height: 1.6;
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                font-weight: 600;
                color: #2c1810;
                margin-bottom: 6px;
                font-size: 0.9rem;
            }

            .form-group .input-group {
                position: relative;
            }

                .form-group .input-group i {
                    position: absolute;
                    left: 14px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #b99a85;
                }

        .form-control {
            width: 100%;
            padding: 12px 15px 12px 45px;
            border: 2px solid #e8d9cc;
            border-radius: 12px;
            font-size: 16px;
            transition: all 0.3s;
            background: #faf7f2;
        }

            .form-control:focus {
                border-color: #800000;
                outline: none;
                box-shadow: 0 0 0 3px rgba(128, 0, 0, 0.1);
                background: white;
            }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #800000 0%, #5a0000 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(128, 0, 0, 0.3);
            }

            .btn-submit:disabled {
                opacity: 0.7;
                cursor: not-allowed;
                transform: none;
            }

            .btn-submit i {
                margin-right: 8px;
            }

        .back-to-login {
            text-align: center;
            margin-top: 20px;
        }

            .back-to-login a {
                color: #800000;
                text-decoration: none;
                font-weight: 500;
                transition: color 0.3s;
            }

                .back-to-login a:hover {
                    color: #5a0000;
                    text-decoration: underline;
                }

        .alert {
            padding: 14px 18px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border-left: 4px solid #28a745;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border-left: 4px solid #dc3545;
        }

        .alert i {
            margin-right: 8px;
        }

        .validation-summary {
            color: #dc3545;
            font-size: 0.85rem;
            margin-top: 5px;
        }

        .field-validation-error {
            color: #dc3545;
            font-size: 0.8rem;
            display: block;
            margin-top: 4px;
        }

        .password-hint {
            font-size: 0.8rem;
            color: #7d6b5e;
            margin-top: 5px;
        }

        @@media (max-width: 480px) {
            .reset-container {
                padding: 30px 20px;
            }

            .reset-header h1 {
                font-size: 1.5em;
            }
        }
    </style>
</head>
<body>
    <div class="reset-container">
        <div class="reset-header">
            <div class="icon">
                <i class="fas fa-lock"></i>
            </div>
            <h1>Reset Password</h1>
            <p>Enter your new password below.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            </div>
        }

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="form-group">
                <label asp-for="Password">New Password</label>
                <div class="input-group">
                    <i class="fas fa-key"></i>
                    <input asp-for="Password" class="form-control" placeholder="Enter new password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
                <div class="password-hint">
                    <i class="fas fa-info-circle"></i> Password must be at least 6 characters long.
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <div class="input-group">
                    <i class="fas fa-check"></i>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">
                <i class="fas fa-save"></i> Reset Password
            </button>
        </form>

        <div class="back-to-login">
            <a asp-action="Login">
                <i class="fas fa-arrow-left"></i> Back to Login
            </a>
        </div>
    </div>

    @section Scripts {
        @await Html.PartialAsync("_ValidationScriptsPartial")

        <script>
            document.getElementById('submitBtn').addEventListener('click', function () {
                this.disabled = true;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Resetting...';
            });
        </script>
    }
</body>
</html>