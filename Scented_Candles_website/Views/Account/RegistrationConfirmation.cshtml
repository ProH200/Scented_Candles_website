@{
    ViewData["Title"] = "Registration Successful";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="text-center mb-0">Registration Successful!</h3>
                </div>
                <div class="card-body text-center">
                    <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                    <h4>Thank you for registering!</h4>
                    <p>Your account has been created successfully.</p>
                    <p>Please login using your email and password.</p>
                    <a asp-action="Login" class="btn btn-primary btn-lg mt-3">Go to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>