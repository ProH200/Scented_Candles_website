@model Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-success">
                <div class="card-header bg-success text-white text-center">
                    <i class="fas fa-check-circle fa-3x"></i>
                    <h2 class="mb-0">Order Confirmed!</h2>
                </div>
                <div class="card-body text-center">
                    <h4>Thank you for your purchase!</h4>
                    <p class="lead">Your order has been placed successfully.</p>

                    <div class="alert alert-info">
                        <strong>Order #@Model.Id</strong><br />
                        <small>Order Date: @Model.OrderDate.ToString("MMMM dd, yyyy hh:mm tt")</small>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6 text-start">
                            <h5>Shipping Address</h5>
                            <p class="mb-0">@Model.ShippingAddress</p>
                            <p class="mb-0">@Model.City, @Model.PostalCode</p>
                            <p>@Model.Country</p>
                            <p><i class="fas fa-phone"></i> @Model.PhoneNumber</p>
                        </div>
                        <div class="col-md-6 text-start">
                            <h5>Order Summary</h5>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Item</th>
                                            <th>Qty</th>
                                            <th>Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.OrderItems)
                                        {
                                            <tr>
                                                <td>@item.Product?.Name</td>
                                                <td>@item.Quantity</td>
                                                <td>@item.Price.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="2" class="text-end">Total:</th>
                                            <th>@Model.TotalAmount.ToString("C")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <p class="text-muted">You will receive an email confirmation shortly.</p>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-candle"></i> Continue Shopping
                        </a>
                        <a asp-controller="Order" asp-action="History" class="btn btn-outline-secondary ms-2">
                            <i class="fas fa-history"></i> View Order History
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>