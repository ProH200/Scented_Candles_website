@model List<CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    var subtotal = ViewBag.Subtotal;
    var shipping = ViewBag.Shipping;
    var total = ViewBag.Total;
}

<div class="container mt-4">
    <h1 class="mb-4" style="color: #4a0000;">
        <i class="fas fa-shopping-cart" style="color: #800000;"></i> Shopping Cart
        @if (Model.Any())
        {
            <span class="badge" style="background: linear-gradient(135deg, #800000 0%, #5a0000 100%);">@ViewBag.CartCount items</span>
        }
    </h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5" style="background: #f8f9fa; border-radius: 20px;">
            <i class="fas fa-shopping-cart fa-5x mb-3" style="color: #800000;"></i>
            <h3 style="color: #4a0000;">Your cart is empty</h3>
            <p class="text-muted">Looks like you haven't added any candles to your cart yet.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-lg" style="background: linear-gradient(135deg, #800000 0%, #5a0000 100%); color: white; border: none; border-radius: 50px; padding: 12px 30px;">
                <i class="fas fa-candle me-2"></i> Browse Candles
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden;">
                    <div class="card-header" style="background: linear-gradient(135deg, #800000 0%, #5a0000 100%); color: white; border: none;">
                        <h5 class="mb-0">
                            <i class="fas fa-shopping-cart me-2"></i> Cart Items (@ViewBag.CartCount)
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead style="background: #f8f9fa;">
                                    <tr style="color: #4a0000;">
                                        <th class="ps-4">Product</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th>Subtotal</th>
                                        <th class="pe-4"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr id="cart-item-@item.Id" style="border-bottom: 1px solid #f0f0f0;">
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                                    {
                                                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" style="width: 70px; height: 70px; object-fit: cover; border-radius: 12px;" class="me-3">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light me-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; border-radius: 12px;">
                                                            <i class="fas fa-candle fa-2x" style="color: #800000;"></i>
                                                        </div>
                                                    }
                                                    <div>
                                                        <h6 class="mb-0 fw-semibold" style="color: #4a0000;">@item.Product?.Name</h6>
                                                        <small class="text-muted">
                                                            <i class="fas fa-leaf me-1" style="color: #800000;"></i>@item.Product?.Scent
                                                        </small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="fw-semibold" style="color: #800000;">@item.Product?.Price.ToString("C")</td>
                                            <td style="width: 130px;">
                                                <div class="input-group">
                                                    <button class="btn btn-outline-secondary btn-sm" type="button" onclick="updateQuantity(@item.Id, @(item.Quantity - 1))" style="border-color: #800000; color: #800000;">
                                                        <i class="fas fa-minus"></i>
                                                    </button>
                                                    <input type="number" id="qty-@item.Id" value="@item.Quantity" class="form-control form-control-sm text-center" min="1" max="@item.Product?.StockQuantity" style="width: 50px; border-color: #800000;" onchange="updateQuantity(@item.Id, this.value)">
                                                    <button class="btn btn-outline-secondary btn-sm" type="button" onclick="updateQuantity(@item.Id, @(item.Quantity + 1))" style="border-color: #800000; color: #800000;">
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="fw-bold" id="subtotal-@item.Id" style="color: #800000;">
                                                @((item.Quantity * (item.Product?.Price ?? 0)).ToString("C"))
                                            </td>
                                            <td class="pe-4">
                                                <button class="btn btn-sm" onclick="removeItem(@item.Id)" style="background: #dc3545; color: white; border-radius: 10px;">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden; position: sticky; top: 20px;">
                    <div class="card-header" style="background: linear-gradient(135deg, #800000 0%, #5a0000 100%); color: white; border: none;">
                        <h5 class="mb-0">
                            <i class="fas fa-receipt me-2"></i> Order Summary
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <!-- Cart Items Summary -->
                        <div class="summary-items mb-3" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var item in Model)
                            {
                                <div class="d-flex justify-content-between mb-2 pb-2" style="border-bottom: 1px solid #f0f0f0;">
                                    <span style="color: #4a0000;">@item.Product?.Name x @item.Quantity</span>
                                    <span style="color: #800000;">@((item.Quantity * (item.Product?.Price ?? 0)).ToString("C"))</span>
                                </div>
                            }
                        </div>

                        <hr class="my-3" style="border-color: #f0f0f0;">

                        <!-- Totals -->
                        <div class="totals">
                            <div class="d-flex justify-content-between mb-2">
                                <span style="color: #4a0000;">Subtotal</span>
                                <span id="subtotalDisplay" style="color: #800000;">@subtotal.ToString("C")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span style="color: #4a0000;">Shipping</span>
                                <span id="shippingDisplay" style="color: #800000;">@shipping.ToString("C")</span>
                            </div>
                            <hr class="my-2" style="border-color: #f0f0f0;">
                            <div class="d-flex justify-content-between mb-3">
                                <strong style="color: #4a0000;">Total</strong>
                                <strong id="totalDisplay" style="color: #800000; font-size: 1.3rem;">@total.ToString("C")</strong>
                            </div>
                        </div>

                        <!-- Free Shipping Info -->
                        @if (subtotal > 200)
                        {
                            <div class="alert alert-info small mt-3" style="background: rgba(128, 0, 0, 0.05); border: none; border-left: 3px solid #800000; border-radius: 12px;">
                                <i class="fas fa-truck me-2" style="color: #800000;"></i>
                                Add <strong>@((100 - subtotal).ToString("C"))</strong> more to get free shipping!
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success small mt-3" style="background: rgba(40, 167, 69, 0.1); border: none; border-left: 3px solid #28a745; border-radius: 12px;">
                                <i class="fas fa-truck me-2" style="color: #28a745;"></i>
                                You qualify for <strong>FREE SHIPPING!</strong>
                            </div>
                        }

                        <!-- Checkout Buttons -->
                        <a asp-action="Checkout" class="btn btn-lg w-100 mt-3" style="background: linear-gradient(135deg, #800000 0%, #5a0000 100%); color: white; border: none; border-radius: 50px; padding: 14px; font-weight: 600; transition: all 0.3s ease;">
                            <i class="fas fa-credit-card me-2"></i> Proceed to Checkout
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2" style="border-radius: 50px; padding: 12px; border-color: #800000; color: #800000;">
                            <i class="fas fa-candle me-2"></i> Continue Shopping
                        </a>

                        <!-- Secure Payment Info -->
                        <div class="text-center mt-4 pt-2">
                            <p class="small text-muted mb-2">
                                <i class="fas fa-lock me-1" style="color: #800000;"></i> Secure Checkout
                            </p>
                            <div>
                                <i class="fab fa-cc-visa fa-2x me-2" style="color: #1a1f71;"></i>
                                <i class="fab fa-cc-mastercard fa-2x me-2" style="color: #eb001b;"></i>
                                <i class="fab fa-cc-amex fa-2x me-2" style="color: #006fcf;"></i>
                                <i class="fab fa-cc-paypal fa-2x" style="color: #003087;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Quantity Input Styling */
    .input-group .btn:hover {
        background: #800000;
        border-color: #800000;
        color: white;
    }

    .input-group input:focus {
        border-color: #800000;
        box-shadow: 0 0 0 0.2rem rgba(128, 0, 0, 0.25);
    }

    /* Table Row Hover */
    .table-hover tbody tr:hover {
        background: rgba(128, 0, 0, 0.03);
    }

    /* Summary Items Scrollbar */
    .summary-items::-webkit-scrollbar {
        width: 5px;
    }

    .summary-items::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .summary-items::-webkit-scrollbar-thumb {
        background: #800000;
        border-radius: 10px;
    }

    /* Button Hover Effects */
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(128, 0, 0, 0.3);
    }

    /* Sticky Order Summary */
    @@media (min-width: 992px) {
        .col-lg-4 .card {
            position: sticky;
            top: 20px;
        }
    }

    /* Card Animation */
    .card {
        animation: fadeInUp 0.5s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive Adjustments */
    @@media (max-width: 768px) {
        h1 {
            font-size: 1.8rem;
        }

        .table-responsive {
            font-size: 0.85rem;
        }

        .btn {
            padding: 10px;
        }
    }

    /* Remove number input arrows */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        opacity: 0.5;
    }
</style>

@section Scripts {
    <script>
    // ===== UPDATE QUANTITY =====
    function updateQuantity(cartItemId, newQuantity) {
        // Validate quantity
        newQuantity = parseInt(newQuantity);
        if (isNaN(newQuantity) || newQuantity < 1) {
            newQuantity = 1;
        }

        // Show loading state on quantity buttons
        const buttons = $(`#cart-item-${cartItemId} .btn`);
        buttons.prop('disabled', true);
        
        // Show loading on the quantity input
        const input = $(`#cart-item-${cartItemId} .quantity-input`);
        input.css('opacity', '0.5');

        // Get anti-forgery token
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        const tokenValue = token ? token.value : '';

        $.ajax({
            url: '@Url.Action("UpdateQuantity", "Cart")',
            type: 'POST',
            data: {
                cartItemId: cartItemId,
                quantity: newQuantity,
                __RequestVerificationToken: tokenValue
            },
            success: function (response) {
                if (response.success) {
                    // Show success notification
                    showNotification('Cart updated successfully!', 'success');
                    
                    // Reload after a moment to show updated cart
                    setTimeout(function () {
                        location.reload();
                    }, 1000);
                } else {
                    showNotification(response.message || 'Error updating cart', 'error');
                    buttons.prop('disabled', false);
                    input.css('opacity', '1');
                }
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
                showNotification('Error updating cart. Please try again.', 'error');
                buttons.prop('disabled', false);
                input.css('opacity', '1');
            }
        });
    }

    // ===== REMOVE ITEM =====
    function removeItem(cartItemId) {
        if (!confirm('Remove this item from your cart?')) {
            return;
        }

        // Show loading state on remove button
        const button = $(`#cart-item-${cartItemId} .btn-danger`);
        const originalText = button.html();
        button.html('<i class="fas fa-spinner fa-spin"></i>');
        button.prop('disabled', true);

        // Get anti-forgery token
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        const tokenValue = token ? token.value : '';

        $.ajax({
            url: '@Url.Action("RemoveItem", "Cart")',
            type: 'POST',
            data: {
                cartItemId: cartItemId,
                __RequestVerificationToken: tokenValue
            },
            success: function (response) {
                if (response.success) {
                    showNotification('Item removed from cart.', 'success');
                    
                    // Remove the item row with animation
                    $(`#cart-item-${cartItemId}`).fadeOut('slow', function() {
                        // Check if cart is empty
                        if ($('#cart-items-container .cart-item').length === 1) {
                            location.reload();
                        } else {
                            // Update totals
                            if (response.cartCount !== undefined) {
                                updateCartBadge(response.cartCount);
                            }
                            location.reload();
                        }
                    });
                } else {
                    showNotification(response.message || 'Error removing item', 'error');
                    button.html(originalText);
                    button.prop('disabled', false);
                }
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
                showNotification('Error removing item. Please try again.', 'error');
                button.html(originalText);
                button.prop('disabled', false);
            }
        });
    }

    // ===== CLEAR CART =====
    function clearCart() {
        if (!confirm('Are you sure you want to clear your entire cart?')) {
            return;
        }

        const button = $('#clearCartBtn');
        const originalText = button.html();
        button.html('<i class="fas fa-spinner fa-spin"></i> Clearing...');
        button.prop('disabled', true);

        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        const tokenValue = token ? token.value : '';

        $.ajax({
            url: '@Url.Action("ClearCart", "Cart")',
            type: 'POST',
            data: {
                __RequestVerificationToken: tokenValue
            },
            success: function (response) {
                if (response.success) {
                    showNotification('Cart cleared successfully.', 'success');
                    setTimeout(function () {
                        location.reload();
                    }, 1000);
                } else {
                    showNotification(response.message || 'Error clearing cart', 'error');
                    button.html(originalText);
                    button.prop('disabled', false);
                }
            },
            error: function () {
                showNotification('Error clearing cart. Please try again.', 'error');
                button.html(originalText);
                button.prop('disabled', false);
            }
        });
    }

    // ===== APPLY COUPON =====
    function applyCoupon() {
        const couponCode = $('#couponCode').val().trim();
        
        if (!couponCode) {
            showNotification('Please enter a coupon code.', 'info');
            return;
        }

        const button = $('#applyCouponBtn');
        const originalText = button.html();
        button.html('<i class="fas fa-spinner fa-spin"></i> Applying...');
        button.prop('disabled', true);

        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        const tokenValue = token ? token.value : '';

        $.ajax({
            url: '@Url.Action("ApplyCoupon", "Cart")',
            type: 'POST',
            data: {
                couponCode: couponCode,
                __RequestVerificationToken: tokenValue
            },
            success: function (response) {
                if (response.success) {
                    showNotification(response.message || 'Coupon applied successfully!', 'success');
                    setTimeout(function () {
                        location.reload();
                    }, 1500);
                } else {
                    showNotification(response.message || 'Invalid coupon code.', 'error');
                    button.html(originalText);
                    button.prop('disabled', false);
                }
            },
            error: function () {
                showNotification('Error applying coupon. Please try again.', 'error');
                button.html(originalText);
                button.prop('disabled', false);
            }
        });
    }

    // ===== UPDATE CART BADGE =====
    function updateCartBadge(count) {
        const badge = document.querySelector('.cart-badge');
        if (badge) {
            if (count > 0) {
                badge.textContent = count;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        }
    }

    // ===== NOTIFICATION SYSTEM =====
    function showNotification(message, type) {
        // Remove existing notifications
        $('.custom-notification').remove();

        const colors = {
            success: { bg: '#d4edda', border: '#28a745', text: '#155724', icon: 'fa-check-circle' },
            error: { bg: '#f8d7da', border: '#dc3545', text: '#721c24', icon: 'fa-exclamation-circle' },
            info: { bg: '#d1ecf1', border: '#17a2b8', text: '#0c5460', icon: 'fa-info-circle' }
        };

        const color = colors[type] || colors.info;

        const notification = $(`
            <div class="custom-notification" style="
                position: fixed;
                top: 20px;
                right: 20px;
                background: ${color.bg};
                color: ${color.text};
                padding: 15px 25px;
                border-radius: 12px;
                border-left: 4px solid ${color.border};
                box-shadow: 0 5px 20px rgba(0,0,0,0.1);
                z-index: 9999;
                font-weight: 500;
                max-width: 400px;
                animation: slideInRight 0.5s ease;
                display: flex;
                align-items: center;
                gap: 12px;
            
                <i class="fas ${color.icon}" style="font-size: 20px;"></i>
                <span style="flex: 1;">${message}</span>
                <button type="button" onclick="$(this).closest('.custom-notification').remove()" style="
                    background: none;
                    border: none;
                    font-size: 20px;
                    cursor: pointer;
                    color: ${color.text};
                    padding: 0 5px;
                ">&times;</button>
            </div>
        `);

        $('body').append(notification);

        // Auto-remove after 5 seconds
        setTimeout(function() {
            notification.fadeOut('slow', function() {
                $(this).remove();
            });
        }, 5000);
    }

    // ===== UPDATE QUANTITY INPUT HANDLING =====
    $(document).ready(function() {
        // Handle quantity input changes
        $('.quantity-input').on('change', function() {
            const cartItemId = $(this).data('cartitemid');
            const newQuantity = $(this).val();
            updateQuantity(cartItemId, newQuantity);
        });

        // Handle quantity input keypress (Enter key)
        $('.quantity-input').on('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const cartItemId = $(this).data('cartitemid');
                const newQuantity = $(this).val();
                updateQuantity(cartItemId, newQuantity);
            }
        });

        // Prevent negative numbers in quantity input
        $('.quantity-input').on('keydown', function(e) {
            if (e.key === '-' || e.key === 'e') {
                e.preventDefault();
            }
        });

        // ===== AUTO-HIDE ALERTS =====
        setTimeout(function () {
            $('.alert').fadeOut('slow', function() {
                $(this).remove();
            });
        }, 5000);
    });

    // Add animation styles
    const style = document.createElement('style');
    style.textContent = `
        @@keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
    `;
    document.head.appendChild(style);
</script>
}