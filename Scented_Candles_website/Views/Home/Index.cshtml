@using ScentedCandleWebsite.ViewModels
@model HomePageViewModel
@{
    ViewData["Title"] = "Scented Candles - Handcrafted with Love";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Newsletter Success/Error Messages */
        .newsletter-success {
            background: #d4edda;
            color: #155724;
            padding: 12px 20px;
            border-radius: 10px;
            margin-bottom: 15px;
            border-left: 4px solid #28a745;
            animation: slideDown 0.3s ease-out;
        }

        .newsletter-error {
            background: #f8d7da;
            color: #721c24;
            padding: 12px 20px;
            border-radius: 10px;
            margin-bottom: 15px;
            border-left: 4px solid #dc3545;
            animation: slideDown 0.3s ease-out;
        }

            .newsletter-success i,
            .newsletter-error i {
                margin-right: 8px;
            }

        @@keyframes slideDown {
            from {
                transform: translateY(-20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }
        /* ===== RESET & BASE ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #faf7f2;
            color: #2c1810;
            line-height: 1.6;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* ===== SCROLL ARROW ===== */
        .scroll-arrow {
            position: fixed;
            right: 30px;
            bottom: 30px;
            width: 55px;
            height: 55px;
            background: #b99a85;
            color: white;
            border: none;
            border-radius: 50%;
            font-size: 22px;
            cursor: pointer;
            z-index: 999;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(185, 154, 133, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            animation: floatArrow 2s ease-in-out infinite;
            text-decoration: none;
        }

            .scroll-arrow:hover {
                background: #9c7b66;
                transform: translateY(-3px) scale(1.05);
                box-shadow: 0 8px 25px rgba(185, 154, 133, 0.5);
            }

            .scroll-arrow i {
                transition: transform 0.3s;
            }

            .scroll-arrow:hover i {
                transform: translateY(3px);
            }

        @@keyframes floatArrow {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }
        }

        .scroll-arrow::before {
            content: '';
            position: absolute;
            top: -5px;
            left: -5px;
            right: -5px;
            bottom: -5px;
            border-radius: 50%;
            border: 2px solid rgba(185, 154, 133, 0.3);
            animation: pulseRing 2s ease-in-out infinite;
        }

        @@keyframes pulseRing {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.15);
                opacity: 0;
            }
        }

        /* ===== NAVBAR ===== */
        .navbar {
            padding: 20px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(44, 24, 16, 0.08);
            margin-bottom: 40px;
        }

        .navbar-brand {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 700;
            color: #2c1810;
            text-decoration: none;
        }

            .navbar-brand span {
                color: #b99a85;
            }

        .navbar-links {
            display: flex;
            gap: 30px;
            align-items: center;
        }

            .navbar-links a {
                color: #2c1810;
                text-decoration: none;
                font-weight: 500;
                transition: color 0.3s;
            }

                .navbar-links a:hover {
                    color: #b99a85;
                }

            .navbar-links .cart-icon {
                position: relative;
                font-size: 20px;
            }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background: #b99a85;
            color: white;
            font-size: 10px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        /* ===== HERO SECTION ===== */
        .hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            padding: 60px 0 80px;
            align-items: center;
            min-height: 500px;
        }

        .hero-content h1 {
            font-family: 'Playfair Display', serif;
            font-size: 4em;
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 20px;
            color: #2c1810;
        }

            .hero-content h1 span {
                color: #b99a85;
                font-style: italic;
            }

        .hero-content p {
            font-size: 1.2em;
            color: #7d6b5e;
            margin-bottom: 30px;
            max-width: 450px;
            line-height: 1.8;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn-primary {
            padding: 14px 35px;
            background: #b99a85;
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

            .btn-primary:hover {
                background: #9c7b66;
                transform: translateY(-2px);
                box-shadow: 0 10px 30px rgba(185, 154, 133, 0.3);
            }

        .btn-secondary {
            padding: 14px 35px;
            background: transparent;
            color: #2c1810;
            border: 2px solid #e8d9cc;
            border-radius: 50px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

            .btn-secondary:hover {
                background: #f5eee9;
                border-color: #b99a85;
            }

        .hero-image {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

            .hero-image img {
                max-width: 100%;
                border-radius: 30px;
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.1);
            }

        .hero-floating-badge {
            position: absolute;
            bottom: -20px;
            right: -20px;
            background: white;
            padding: 15px 25px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

            .hero-floating-badge .number {
                font-size: 24px;
                font-weight: 700;
                color: #b99a85;
            }

            .hero-floating-badge .label {
                font-size: 14px;
                color: #7d6b5e;
            }

        /* ===== STATS BAR ===== */
        .stats-bar {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            padding: 40px 0;
            border-top: 1px solid rgba(44, 24, 16, 0.08);
            border-bottom: 1px solid rgba(44, 24, 16, 0.08);
            margin-bottom: 60px;
        }

        .stat-item {
            text-align: center;
        }

            .stat-item .number {
                font-size: 2.2em;
                font-weight: 700;
                color: #b99a85;
                display: block;
            }

            .stat-item .label {
                font-size: 0.9em;
                color: #7d6b5e;
                margin-top: 5px;
            }

        /* ===== FEATURED SECTION ===== */
        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

            .section-header h2 {
                font-family: 'Playfair Display', serif;
                font-size: 2.8em;
                font-weight: 700;
                color: #2c1810;
            }

            .section-header p {
                color: #7d6b5e;
                font-size: 1.1em;
                margin-top: 10px;
            }

        .featured-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            margin-bottom: 60px;
        }

        .featured-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.06);
            transition: all 0.4s;
            text-align: center;
            padding: 30px 20px 25px;
            position: relative;
        }

            .featured-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
            }

            .featured-card .icon {
                width: 70px;
                height: 70px;
                background: #f5eee9;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 20px;
                font-size: 30px;
                color: #b99a85;
            }

            .featured-card h3 {
                font-size: 1.2em;
                margin-bottom: 10px;
            }

            .featured-card p {
                color: #7d6b5e;
                font-size: 0.95em;
            }

        /* ===== PRODUCTS GRID ===== */
        .products-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

            .products-header h2 {
                font-family: 'Playfair Display', serif;
                font-size: 2.2em;
                font-weight: 700;
            }

            .products-header .count {
                color: #7d6b5e;
                font-size: 0.95em;
            }

        /* ===== FILTER BAR ===== */
        .filter-bar {
            background: white;
            padding: 20px 25px;
            border-radius: 16px;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.04);
            margin-bottom: 35px;
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            align-items: center;
            justify-content: space-between;
        }

        .filter-left {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            align-items: center;
        }

        .search-wrapper {
            display: flex;
            align-items: center;
            background: #f5eee9;
            border-radius: 50px;
            padding: 4px 4px 4px 18px;
        }

            .search-wrapper input {
                border: none;
                background: transparent;
                padding: 8px 0;
                font-size: 14px;
                outline: none;
                width: 180px;
                font-family: 'Inter', sans-serif;
            }

            .search-wrapper button {
                background: #b99a85;
                border: none;
                color: white;
                padding: 8px 18px;
                border-radius: 50px;
                cursor: pointer;
                transition: background 0.3s;
                font-size: 14px;
            }

                .search-wrapper button:hover {
                    background: #9c7b66;
                }

        #clearSearch {
            background: transparent;
            color: #999;
            padding: 8px 10px;
        }

            #clearSearch:hover {
                background: transparent;
                color: #f44336;
            }

        .category-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

            .category-pills a {
                padding: 6px 18px;
                border-radius: 50px;
                text-decoration: none;
                color: #2c1810;
                font-size: 14px;
                background: #f5eee9;
                transition: all 0.3s;
                font-weight: 500;
            }

                .category-pills a:hover {
                    background: #e8d9cc;
                }

                .category-pills a.active {
                    background: #b99a85;
                    color: white;
                }

        .filter-right {
            display: flex;
            gap: 10px;
            align-items: center;
        }

            .filter-right select {
                padding: 8px 15px;
                border: 2px solid #e8d9cc;
                border-radius: 50px;
                background: white;
                font-size: 14px;
                cursor: pointer;
                font-family: 'Inter', sans-serif;
                outline: none;
            }

                .filter-right select:focus {
                    border-color: #b99a85;
                }

        /* ===== PRODUCTS GRID ===== */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
            margin-bottom: 50px;
        }

        .product-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.06);
            transition: all 0.4s;
            position: relative;
        }

            .product-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 35px rgba(0, 0, 0, 0.1);
            }

        .product-image-wrap {
            position: relative;
            overflow: hidden;
            height: 260px;
        }

            .product-image-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s;
            }

        .product-card:hover .product-image-wrap img {
            transform: scale(1.05);
        }

        .product-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 4px 14px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge-featured {
            background: #b99a85;
            color: white;
        }

        .badge-sale {
            background: #f44336;
            color: white;
        }

        .badge-new {
            background: #4CAF50;
            color: white;
        }

        .product-info {
            padding: 18px 20px 20px;
        }

        .product-category {
            font-size: 12px;
            color: #b99a85;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .product-name {
            font-size: 1.1em;
            font-weight: 600;
            margin-bottom: 4px;
        }

            .product-name a {
                color: #2c1810;
                text-decoration: none;
                transition: color 0.3s;
            }

                .product-name a:hover {
                    color: #b99a85;
                }

        .product-scent {
            font-size: 0.85em;
            color: #7d6b5e;
            margin-bottom: 10px;
        }

            .product-scent i {
                margin-right: 4px;
                color: #b99a85;
            }

        .product-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 12px;
            border-top: 1px solid #f0e4d8;
        }

        .product-price {
            font-size: 1.2em;
            font-weight: 700;
            color: #2c1810;
        }

            .product-price .original {
                font-size: 0.7em;
                color: #999;
                text-decoration: line-through;
                font-weight: 400;
                margin-left: 8px;
            }

            .product-price .sale-price {
                color: #f44336;
            }

        .btn-quick-add {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: #f5eee9;
            color: #2c1810;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 16px;
        }

            .btn-quick-add:hover {
                background: #b99a85;
                color: white;
                transform: scale(1.05);
            }

        /* ===== EMPTY STATE ===== */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
        }

            .empty-state i {
                font-size: 60px;
                color: #e8d9cc;
                margin-bottom: 20px;
            }

            .empty-state h3 {
                font-size: 1.5em;
                color: #2c1810;
            }

            .empty-state p {
                color: #7d6b5e;
                margin: 10px 0 20px;
            }

        /* ===== NEWSLETTER ===== */
        .newsletter {
            background: #2c1810;
            border-radius: 20px;
            padding: 60px 40px;
            margin: 60px 0;
            text-align: center;
            color: white;
        }

            .newsletter h2 {
                font-family: 'Playfair Display', serif;
                font-size: 2.4em;
                margin-bottom: 10px;
            }

            .newsletter p {
                color: rgba(255, 255, 255, 0.7);
                margin-bottom: 25px;
            }

        .newsletter-form {
            display: flex;
            max-width: 500px;
            margin: 0 auto;
            gap: 10px;
        }

            .newsletter-form input {
                flex: 1;
                padding: 14px 20px;
                border: none;
                border-radius: 50px;
                font-size: 16px;
                outline: none;
            }

            .newsletter-form button {
                padding: 14px 30px;
                background: #b99a85;
                color: white;
                border: none;
                border-radius: 50px;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: background 0.3s;
            }

                .newsletter-form button:hover {
                    background: #9c7b66;
                }

        /* ===== FOOTER ===== */
        .footer {
            padding: 40px 0 20px;
            border-top: 1px solid rgba(44, 24, 16, 0.08);
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 40px;
        }

        .footer-brand h3 {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
        }

            .footer-brand h3 span {
                color: #b99a85;
            }

        .footer-brand p {
            color: #7d6b5e;
            font-size: 0.95em;
            margin-top: 10px;
            max-width: 300px;
        }

        .footer h4 {
            font-size: 1em;
            margin-bottom: 15px;
        }

        .footer a {
            display: block;
            color: #7d6b5e;
            text-decoration: none;
            padding: 4px 0;
            font-size: 0.95em;
            transition: color 0.3s;
        }

            .footer a:hover {
                color: #b99a85;
            }

        .footer-social {
            display: flex;
            gap: 15px;
            margin-top: 15px;
        }

            .footer-social a {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: #f5eee9;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #2c1810;
                text-decoration: none;
                transition: all 0.3s;
            }

                .footer-social a:hover {
                    background: #b99a85;
                    color: white;
                }

        .footer-bottom {
            grid-column: 1 / -1;
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid rgba(44, 24, 16, 0.08);
            color: #7d6b5e;
            font-size: 0.9em;
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 1024px) {
            .hero {
                grid-template-columns: 1fr;
                text-align: center;
                padding: 40px 0 60px;
            }

            .hero-content p {
                margin: 0 auto 30px;
            }

            .hero-buttons {
                justify-content: center;
            }

            .footer {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 768px) {
            .navbar {
                flex-direction: column;
                gap: 15px;
            }

            .hero-content h1 {
                font-size: 2.5em;
            }

            .stats-bar {
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }

            .featured-grid {
                grid-template-columns: 1fr;
            }

            .filter-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .filter-left {
                flex-direction: column;
            }

            .search-wrapper {
                width: 100%;
            }

                .search-wrapper input {
                    width: 100%;
                }

            .footer {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .newsletter {
                padding: 40px 20px;
            }

            .newsletter-form {
                flex-direction: column;
            }

            .hero-floating-badge {
                display: none;
            }

            .scroll-arrow {
                width: 45px;
                height: 45px;
                right: 15px;
                bottom: 15px;
                font-size: 18px;
            }
        }

        @@media (max-width: 480px) {
            .products-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- ===== NAVBAR ===== -->
       @*  <nav class="navbar">
            <a href="/" class="navbar-brand">Scented<span>Candles</span></a>
            <div class="navbar-links">
                <a href="/">Home</a>
                <a href="#products">Shop</a>
                <a href="#about">About</a>
                <a href="#" class="cart-icon">
                    <i class="fas fa-shopping-bag"></i>
                    <span class="cart-badge">0</span>
                </a>
            </div>
        </nav> *@

        <!-- ===== HERO SECTION ===== -->
        <section class="hero" id="hero">
            <div class="hero-content">
                <h1>Illuminate Your <span>World</span></h1>
                <p>Handcrafted soy candles made with love and the finest natural ingredients. Find your perfect scent.</p>
                <div class="hero-buttons">
                    <a href="#products" class="btn-primary">Explore Collection</a>
                    <a href="#about" class="btn-secondary">Our Story</a>
                </div>
            </div>
            <div class="hero-image">
                <img src="https://images.unsplash.com/photo-1603006905003-be475563bc59?w=600&h=500&fit=crop" alt="Scented Candles">
                <div class="hero-floating-badge">
                    <div class="number">@Model.TotalProducts+</div>
                    <div class="label">Unique Scents</div>
                </div>
            </div>
        </section>

        <!-- ===== SCROLL ARROW ===== -->
        <a href="#products" class="scroll-arrow" id="scrollArrow" aria-label="Scroll to products">
            <i class="fas fa-chevron-down"></i>
        </a>

        <!-- ===== STATS BAR ===== -->
        <div class="stats-bar">
            <div class="stat-item">
                <span class="number">@Model.TotalProducts</span>
                <span class="label">Artisan Candles</span>
            </div>
            <div class="stat-item">
                <span class="number">@Model.NewArrivals</span>
                <span class="label">New Arrivals</span>
            </div>
            <div class="stat-item">
                <span class="number">100%</span>
                <span class="label">Natural Soy Wax</span>
            </div>
        </div>

        <!-- ===== FEATURED SECTION ===== -->
        <section id="about">
            <div class="section-header">
                <h2>Why Choose Us</h2>
                <p>Quality you can see, scents you'll love</p>
            </div>
            <div class="featured-grid">
                <div class="featured-card">
                    <div class="icon"><i class="fas fa-leaf"></i></div>
                    <h3>100% Natural Soy Wax</h3>
                    <p>Clean-burning, eco-friendly, and made from renewable resources.</p>
                </div>
                <div class="featured-card">
                    <div class="icon"><i class="fas fa-hand-sparkles"></i></div>
                    <h3>Handcrafted with Care</h3>
                    <p>Each candle is carefully hand-poured and inspected for perfection.</p>
                </div>
                <div class="featured-card">
                    <div class="icon"><i class="fas fa-heart"></i></div>
                    <h3>Premium Fragrances</h3>
                    <p>Made with high-quality fragrance oils for a lasting, beautiful scent.</p>
                </div>
            </div>
        </section>

        <!-- ===== PRODUCTS SECTION ===== -->
        <section id="products">
            <div class="products-header">
                <h2>Our Collection</h2>
                <span class="count" id="productCount">@Model.Products.Count products</span>
            </div>

            <!-- Filter Bar -->
            <div class="filter-bar">
                <div class="filter-left">
                    <div class="search-wrapper">
                        <input type="text"
                               id="liveSearch"
                               placeholder="Search candles..."
                               value="@Model.SearchTerm"
                               autocomplete="off" />
                        <button type="button" id="clearSearch" style="display: @(string.IsNullOrEmpty(Model.SearchTerm) ? "none" : "block");">
                            <i class="fas fa-times"></i>
                        </button>
                        <button type="button" id="searchButton">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                    <div class="category-pills">
                        <a asp-action="Index"
                           asp-route-category=""
                           asp-route-search="@Model.SearchTerm"
                           asp-route-sort="@Model.SortBy"
                           class="@(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">
                            All
                        </a>
                        @foreach (var category in Model.Categories)
                        {
                            <a asp-action="Index"
                               asp-route-category="@category.Name"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-sort="@Model.SortBy"
                               class="@(Model.SelectedCategory == category.Name ? "active" : "")">
                                @category.Name
                            </a>
                        }
                    </div>
                </div>
                <div class="filter-right">
                    @{
                        var nameSortUrl = Url.Action("Index", new { category = Model.SelectedCategory, search = Model.SearchTerm, sort = "name" });
                        var priceAscSortUrl = Url.Action("Index", new { category = Model.SelectedCategory, search = Model.SearchTerm, sort = "price_asc" });
                        var priceDescSortUrl = Url.Action("Index", new { category = Model.SelectedCategory, search = Model.SearchTerm, sort = "price_desc" });
                        var newestSortUrl = Url.Action("Index", new { category = Model.SelectedCategory, search = Model.SearchTerm, sort = "newest" });
                        var featuredSortUrl = Url.Action("Index", new { category = Model.SelectedCategory, search = Model.SearchTerm, sort = "featured" });
                    }
                    <select onchange="window.location.href = this.value;">
                        <option value="@nameSortUrl" selected="@(Model.SortBy == "name")">Sort by: Name</option>
                        <option value="@priceAscSortUrl" selected="@(Model.SortBy == "price_asc")">Price: Low → High</option>
                        <option value="@priceDescSortUrl" selected="@(Model.SortBy == "price_desc")">Price: High → Low</option>
                        <option value="@newestSortUrl" selected="@(Model.SortBy == "newest")">Newest First</option>
                        <option value="@featuredSortUrl" selected="@(Model.SortBy == "featured")">Featured</option>
                    </select>
                </div>
            </div>

            <!-- Loading Spinner -->
            <div id="searchLoading" style="display: none; text-align: center; padding: 20px;">
                <i class="fas fa-spinner fa-spin" style="font-size: 30px; color: #b99a85;"></i>
            </div>

            <!-- Products Grid - This gets updated by AJAX -->
            <div id="productsContainer">
                @if (Model.Products.Any())
                {
                    <div class="products-grid">
                        @foreach (var product in Model.Products)
                        {
                            <div class="product-card">
                                <div class="product-image-wrap">
                                    @if (product.IsFeatured)
                                    {
                                        <div class="product-badge badge-featured">Featured</div>
                                    }
                                    @if (product.IsOnSale)
                                    {
                                        <div class="product-badge badge-sale">@(product.DiscountPercentage ?? 0)% OFF</div>
                                    }
                                    @if (product.CreatedAt > DateTime.UtcNow.AddDays(-30))
                                    {
                                        <div class="product-badge badge-new" style="top: 56px;">New</div>
                                    }
                                    <img src="@product.ImageUrl" alt="@product.Name"
                                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1603006905003-be475563bc59?w=400&h=260&fit=crop'">
                                </div>
                                <div class="product-info">
                                    <div class="product-category">@product.Category?.Name ?? "Uncategorized"</div>
                                    <div class="product-name">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                                            @product.Name
                                        </a>
                                    </div>
                                    <div class="product-scent">
                                        <i class="fas fa-leaf"></i> @product.Scent
                                    </div>
                                    <div class="product-bottom">
                                        <div class="product-price">
                                            @if (product.IsOnSale && product.SalePrice.HasValue)
                                            {
                                                <span class="sale-price">R@product.SalePrice.Value.ToString("F2")</span>
                                                <span class="original">R@product.Price.ToString("F2")</span>
                                            }
                                            else
                                            {
                                                <span>$@product.Price.ToString("F2")</span>
                                            }
                                        </div>
                                        <button class="btn-quick-add" onclick="addToCart(@product.Id)" title="Add to Cart">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-candle-holder"></i>
                        <h3>No candles found</h3>
                        <p>Try adjusting your filters or search terms</p>
                        <a asp-action="Index" class="btn-primary">View All Candles</a>
                    </div>
                }
            </div>
        </section>

        <!-- ===== NEWSLETTER ===== -->
        <section class="newsletter">
            <h2>Join Our Community</h2>
            <p>Subscribe to receive updates, exclusive offers, and candle care tips</p>

            @if (TempData["NewsletterSuccess"] != null)
            {
                <div class="newsletter-success">
                    <i class="fas fa-check-circle"></i> @TempData["NewsletterSuccess"]
                </div>
            }

            @if (TempData["NewsletterError"] != null)
            {
                <div class="newsletter-error">
                    <i class="fas fa-exclamation-circle"></i> @TempData["NewsletterError"]
                </div>
            }

            <form class="newsletter-form" method="post" asp-action="Subscribe" asp-controller="Home">
                <input type="email" name="email" placeholder="Your email address" required
                       value="@ViewBag.SubscribeEmail" />
                <button type="submit">
                    <i class="fas fa-paper-plane"></i> Subscribe
                </button>
            </form>
        </section>

        <!-- ===== FOOTER ===== -->
        <footer class="footer">
            <div class="footer-brand">
                <h3>Scented<span>Candles</span></h3>
                <p>Handcrafted soy candles made with love and the finest natural ingredients.</p>
               
            </div>
            <div>
                <h4>Quick Links</h4>
                <a href="#">Shop All</a>
                <a href="#">New Arrivals</a>
                <a href="#">Best Sellers</a>
                <a href="#">On Sale</a>
            </div>
            <div>
                <h4>Help</h4>
                <a href="#">Shipping Info</a>
                <a href="#">Returns</a>
                <a href="#">FAQ</a>
                <a href="#">Contact</a>
            </div>
            <div>
                <h4>About</h4>
                <a href="#">Our Story</a>
                <a href="#">Sustainability</a>
                <a href="#">Careers</a>
                <a href="#">Blog</a>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year Scented Candles. All rights reserved.</p>
            </div>
        </footer>
    </div>

    <script>
        // ===== SCROLL ARROW =====
        document.getElementById('scrollArrow').addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });

        // Show/hide scroll arrow based on scroll position
        window.addEventListener('scroll', function () {
            const arrow = document.getElementById('scrollArrow');
            const heroSection = document.getElementById('hero');
            const heroBottom = heroSection.getBoundingClientRect().bottom;

            if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 50) {
                arrow.style.opacity = '0';
                arrow.style.pointerEvents = 'none';
            } else if (heroBottom < 0) {
                arrow.style.opacity = '1';
                arrow.style.pointerEvents = 'auto';
            } else {
                arrow.style.opacity = '1';
                arrow.style.pointerEvents = 'auto';
            }
        });

        // ===== LIVE SEARCH =====
        let searchTimeout;
        const searchInput = document.getElementById('liveSearch');
        const productsContainer = document.getElementById('productsContainer');
        const loadingSpinner = document.getElementById('searchLoading');
        const clearButton = document.getElementById('clearSearch');
        const searchButton = document.getElementById('searchButton');
        const productCount = document.getElementById('productCount');

        // Get current filter values
        function getCurrentFilters() {
            const params = new URLSearchParams(window.location.search);
            return {
                category: params.get('category') || '',
                sort: params.get('sort') || 'name'
            };
        }

        // Perform live search
        function performSearch(query) {
            const filters = getCurrentFilters();

            // Show loading spinner
            if (loadingSpinner) {
                loadingSpinner.style.display = 'block';
            }

            // Build the URL with parameters
            const url = new URL('/Home/SearchProducts', window.location.origin);
            url.searchParams.append('search', query);
            url.searchParams.append('category', filters.category);
            url.searchParams.append('sort', filters.sort);

            // Make AJAX request
            fetch(url.toString(), {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(response => response.text())
                .then(html => {
                    // Update the products container
                    if (productsContainer) {
                        productsContainer.innerHTML = html;
                    }

                    // Hide loading spinner
                    if (loadingSpinner) {
                        loadingSpinner.style.display = 'none';
                    }

                    // Update product count
                    if (productCount) {
                        const count = productsContainer.querySelectorAll('.product-card').length;
                        productCount.textContent = count + ' products';
                    }

                    // Update the URL without refreshing the page
                    const newUrl = new URL(window.location.href);
                    if (query) {
                        newUrl.searchParams.set('search', query);
                    } else {
                        newUrl.searchParams.delete('search');
                    }
                    window.history.pushState({}, '', newUrl);

                    // Show/hide clear button
                    if (clearButton) {
                        clearButton.style.display = query.length > 0 ? 'block' : 'none';
                    }
                })
                .catch(error => {
                    console.error('Search error:', error);
                    if (loadingSpinner) {
                        loadingSpinner.style.display = 'none';
                    }
                });
        }

        // Listen for input events with debounce
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const query = this.value;

                // Clear previous timeout
                clearTimeout(searchTimeout);

                // If query is empty, search immediately
                if (query === '') {
                    performSearch('');
                    return;
                }

                // Debounce: wait 300ms after user stops typing
                searchTimeout = setTimeout(() => {
                    performSearch(query);
                }, 300);
            });

            // Search on Enter key
            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    clearTimeout(searchTimeout);
                    performSearch(this.value);
                }
            });

            // Focus the search input on Ctrl+F or Cmd+F
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
                    e.preventDefault();
                    if (searchInput) {
                        searchInput.focus();
                        searchInput.select();
                    }
                }
            });
        }

        // Clear search button
        if (clearButton) {
            clearButton.addEventListener('click', function () {
                if (searchInput) {
                    searchInput.value = '';
                    performSearch('');
                    searchInput.focus();
                }
            });
        }

        // Search button click - FIXED
        if (searchButton) {
            searchButton.addEventListener('click', function (e) {
                e.preventDefault();
                if (searchInput) {
                    performSearch(searchInput.value);
                }
            });
        }

        // Handle browser back/forward buttons
        window.addEventListener('popstate', function () {
            const params = new URLSearchParams(window.location.search);
            const search = params.get('search') || '';
            if (searchInput) {
                searchInput.value = search;
            }
            performSearch(search);
        });

        // ===== ADD TO CART =====
        function addToCart(productId) {
            fetch('/Cart/Add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ productId: productId, quantity: 1 })
            })
                .then(response => {
                    if (response.ok) {
                        showNotification('Added to cart! 🛍️', 'success');
                        updateCartCount();
                    } else {
                        showNotification('Please login to add to cart', 'info');
                    }
                })
                .catch(() => showNotification('Error adding to cart', 'error'));
        }

        // Update cart count
        function updateCartCount() {
            fetch('/Cart/GetCount')
                .then(response => response.json())
                .then(count => {
                    const badge = document.querySelector('.cart-badge');
                    if (badge) {
                        badge.textContent = count;
                        badge.style.display = count > 0 ? 'flex' : 'none';
                    }
                })
                .catch(() => { });
        }

        // Notification system
        function showNotification(message, type) {
            const colors = {
                success: '#4CAF50',
                error: '#f44336',
                info: '#2196F3'
            };

            const notification = document.createElement('div');
            notification.style.cssText = `
                        position: fixed;
                        bottom: 30px;
                        right: 30px;
                        padding: 16px 28px;
                        background: ${colors[type] || '#2196F3'};
                        color: white;
                        border-radius: 12px;
                        z-index: 9999;
                        box-shadow: 0 8px 30px rgba(0,0,0,0.15);
                        animation: slideUp 0.4s ease;
                        font-weight: 500;
                        max-width: 400px;
                    `;
            notification.textContent = message;
            document.body.appendChild(notification);

            setTimeout(() => {
                notification.style.animation = 'slideDown 0.4s ease';
                setTimeout(() => notification.remove(), 400);
            }, 3500);
        }

        // Add animation styles
        const style = document.createElement('style');
        style.textContent = `
                    @@keyframes slideUp {
                        from { transform: translateY(100px); opacity: 0; }
                        to { transform: translateY(0); opacity: 1; }
                    }
                    @@keyframes slideDown {
                        from { transform: translateY(0); opacity: 1; }
                        to { transform: translateY(100px); opacity: 0; }
                    }
                `;
        document.head.appendChild(style);

        // Update cart count on page load
        document.addEventListener('DOMContentLoaded', function () {
            updateCartCount();

            // Show clear button if there's a search term
            if (searchInput && searchInput.value.length > 0 && clearButton) {
                clearButton.style.display = 'block';
            }
        });
    </script>
</body>
</html>